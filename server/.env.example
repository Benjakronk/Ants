# MAUR server settings. Copy to server/.env and edit (pm2's env in
# deploy/ecosystem.config.cjs sets PORT and HOST too; the real environment wins).
PORT=3006
HOST=127.0.0.1

# matches at once (lobbies included; each running one is a simulation,
# ~1-4 ms per tick), players per co-op room and persistent world (1-8), and
# versus players a side (1-8; 8v8 is a room of 16)
MAX_ROOMS=4
MAX_PLAYERS=8
SIDE_MAX=8
# the CPU every running room together may use, in ms per 16.7 ms frame
# (10: about 60% of one core); above it new matches and joins get
# SERVER FULL. /api/health shows the load.
CPU_BUDGET_MS=10

# persistent worlds: a count (the first of MAURTUA, ENGA, SKOGEN, LYNGEN)
# or a comma-separated list of names; 0 for none. Each sleeps (no CPU)
# while nobody is in it.
PERSIST_WORLDS=1
# where the worlds are saved (JSON, one file per world plus a .bak): must
# be writable, and backed up (see deploy/README.md)
#DATA_DIR=/srv/maur/data
# a running world saves this often (milliseconds; also when it falls
# asleep and when the server stops)
AUTOSAVE_MS=120000
# WebSocket connections at most
MAX_CONNS=64

# an empty room closes after this; an ended match after this; a player who
# lost the connection keeps its place this long (milliseconds)
ROOM_IDLE_MS=60000
ROOM_OVER_MS=300000
RECONNECT_MS=120000

# where index.html and js/ are (default: ../public if it exists, else the
# repo root) and the sim files (default: STATIC_DIR/js)
#STATIC_DIR=/srv/maur/public
#SIM_DIR=/srv/maur/public/js

# test hooks (/api/stats, running code in a room). NEVER in production.
#MAUR_DEV=1
